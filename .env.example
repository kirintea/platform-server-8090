# ============================================================
# 环境变量模板 — 复制为 .env 并填入真实值
# ============================================================

# LLM 配置 (必填)
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=http://xxx/v1
LLM_MODEL_NAME=glm-5

# OTel 认证 Token (生产环境必填)
OTEL_TOKEN=your-otel-token

# 数据库 (可选)
DATABASE_URL=
DB_PASSWORD=

# Redis (可选)
REDIS_URL=redis://localhost:6379/0

# 应用环境: dev / prod
APP_ENV=dev
